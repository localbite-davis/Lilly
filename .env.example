# Copy this to .env and fill in your keys.
# Run "bash setup.sh" once, then "bash start.sh" to launch everything.

# Database — defaults to SQLite if left blank (fine for local dev without Docker)
DATABASE_URL=postgresql://lily_user:lily_password@localhost:5432/lily_db

# Twilio — needed only for full phone call testing
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Anthropic (Claude) — needed for LLM responses
ANTHROPIC_API_KEY=sk-ant-...

# Deepgram — needed for STT (free tier at deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_key

# ElevenLabs — needed for TTS (free tier at elevenlabs.io)
ELEVENLABS_API_KEY=your_elevenlabs_key
# Optional: override the default voice (Sarah). Find IDs at elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Layer 2 brain settings
LILY_MODEL=claude-sonnet-4-6
LILY_MODEL_FALLBACK=claude-haiku-4-5-20251001
LILY_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ENVIRONMENT=dev
LOG_LEVEL=INFO
PHI_REDACTION=on
